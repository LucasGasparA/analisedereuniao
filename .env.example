# Nunca coloque valores reais neste arquivo. Configure-os no painel do Railway.
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_SECRET=

# No Railway, monte um volume persistente neste caminho.
DATA_DIR=/app/data

# A imagem padrão do Railway não inclui Whisper/FFmpeg.
TRANSCRIBE_ENABLED=0

# Recomendado em ambiente público. Use 0 somente se quiser remover o limite.
MAX_UPLOAD_MB=600

# Opcional: domínios separados por vírgula, sem https://.
# ALLOWED_HOSTS=seu-app.up.railway.app,seu-dominio.com.br
