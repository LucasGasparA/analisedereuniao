# Nunca coloque valores reais neste arquivo. Configure-os no painel do Railway.
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_SECRET=

# No Railway, monte um volume persistente neste caminho.
DATA_DIR=/app/data

# A imagem padrão do Railway não inclui o Whisper.
TRANSCRIBE_ENABLED=0

# Perfis opcionais. Os padrões são small/small/medium.
WHISPER_DEFAULT_PROFILE=equilibrado
# WHISPER_FAST_MODEL=small
# WHISPER_BALANCED_MODEL=small
# WHISPER_PRECISE_MODEL=medium
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Recomendado em ambiente público. Use 0 somente se quiser remover o limite.
MAX_UPLOAD_MB=600

# Opcional: domínios separados por vírgula, sem https://.
# ALLOWED_HOSTS=seu-app.up.railway.app,seu-dominio.com.br
